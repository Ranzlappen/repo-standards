# Example environment file. Copy to `.env` (which is gitignored) and fill in.
#
# Rules:
#   - .env is NEVER committed. Only this .env.example template is tracked.
#   - One variable per line: KEY=value (no quotes unless the value contains
#     whitespace; even then prefer KEY="value with spaces").
#   - Group by purpose with comment headers.
#   - Document each variable with a comment line above it explaining what
#     the value is, where it comes from, and whether it's required.

# === Application ============================================================

# Required. Public base URL the app is served from. Trailing slash optional.
PUBLIC_BASE_URL=http://localhost:5173

# Optional. Enables verbose logging when set to "true".
DEBUG=false

# === Database ===============================================================

# Required. Connection string. Do NOT commit credentials.
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=

# === Third-party services ===================================================

# Required for production deploys; optional locally if mocking.
# Get from <https://dashboard.example.com/api-keys>. Rotate every 90 days.
EXAMPLE_SERVICE_API_KEY=

# Optional. Webhook secret for verifying incoming requests from <provider>.
EXAMPLE_WEBHOOK_SECRET=

# === Feature flags ==========================================================

# Optional. Comma-separated list of feature names to enable in this env.
FEATURE_FLAGS=

# === Notes ==================================================================
#
# Adding a new variable?
#   1. Add it here with a comment.
#   2. Add a default in the loader if absence shouldn't crash the app.
#   3. Document it in CLAUDE.md under "Required secrets".
#   4. Add it to the CI workflow's secret list (or the deploy target) if
#      it's needed at build time, not just runtime.
