# .gitattributes — starter Git LFS + line-ending config for repo-standards consumers.
#
# To adopt:
#   1. Copy this file to .gitattributes at your repo root.
#   2. Install Git LFS once per machine: `git lfs install`.
#   3. For existing large files already in history, migrate them:
#        git lfs migrate import --include="*.psd,*.mp4,*.zip" --everything
#      (Coordinate with collaborators — this rewrites history.)
#   4. Add new large binaries normally; LFS picks them up via the filters below.
#
# Cross-reference: UPGRADE_CHECKLIST.md §2 (Upload hygiene) and
# scripts/dogfood-audit.py section [9/9] enforce the 5 MB / 50 MB / 100 MB /
# 1 GB GitHub thresholds. LFS keeps you compliant when large binaries are
# genuinely required.

# ── Design source files ───────────────────────────────────────────────────
*.psd      filter=lfs diff=lfs merge=lfs -text
*.ai       filter=lfs diff=lfs merge=lfs -text
*.sketch   filter=lfs diff=lfs merge=lfs -text
*.fig      filter=lfs diff=lfs merge=lfs -text
*.xd       filter=lfs diff=lfs merge=lfs -text

# ── Video / audio ─────────────────────────────────────────────────────────
*.mp4      filter=lfs diff=lfs merge=lfs -text
*.mov      filter=lfs diff=lfs merge=lfs -text
*.webm     filter=lfs diff=lfs merge=lfs -text
*.mkv      filter=lfs diff=lfs merge=lfs -text
*.wav      filter=lfs diff=lfs merge=lfs -text
*.flac     filter=lfs diff=lfs merge=lfs -text

# ── 3D / game assets ──────────────────────────────────────────────────────
*.fbx      filter=lfs diff=lfs merge=lfs -text
*.glb      filter=lfs diff=lfs merge=lfs -text
*.gltf     filter=lfs diff=lfs merge=lfs -text
*.blend    filter=lfs diff=lfs merge=lfs -text
*.obj      filter=lfs diff=lfs merge=lfs -text

# ── Archives / installers / disk images ──────────────────────────────────
*.zip      filter=lfs diff=lfs merge=lfs -text
*.tar.gz   filter=lfs diff=lfs merge=lfs -text
*.tgz      filter=lfs diff=lfs merge=lfs -text
*.7z       filter=lfs diff=lfs merge=lfs -text
*.dmg      filter=lfs diff=lfs merge=lfs -text
*.iso      filter=lfs diff=lfs merge=lfs -text
*.exe      filter=lfs diff=lfs merge=lfs -text
*.apk      filter=lfs diff=lfs merge=lfs -text
*.aab      filter=lfs diff=lfs merge=lfs -text
*.ipa      filter=lfs diff=lfs merge=lfs -text

# ── Large datasets / ML weights (uncomment per-project) ───────────────────
# *.parquet  filter=lfs diff=lfs merge=lfs -text
# *.onnx     filter=lfs diff=lfs merge=lfs -text
# *.pt       filter=lfs diff=lfs merge=lfs -text
# *.safetensors filter=lfs diff=lfs merge=lfs -text

# ── Line endings: normalize source to LF, leave binaries alone ────────────
* text=auto eol=lf
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.pdf      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
