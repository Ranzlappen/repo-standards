# =============================================================================
# Combined .gitignore for Ranzlappen-style repos.
#
# Scope: Node / Vite / Python / JVM / Android / static sites / IDE / OS noise
#        plus a Secrets section that comes FIRST so it's never accidentally
#        deleted while pruning the others.
#
# Trim the sections you don't need for a given project, but never the Secrets
# section. If you add new ignored paths, add them to the matching section
# rather than appending at the bottom — keeps the file scannable.
# =============================================================================


# === Secrets / .env =========================================================
# Anything credential-shaped, ever. .env.example is the only env file we
# track; the rest are local-only. service-account*.json catches Firebase /
# GCP service-account keys by name pattern.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.cer
*.crt
secrets/
service-account*.json
credentials.json
*.credentials.json


# === Node / Vite / npm / pnpm / yarn ========================================
# node_modules is huge and reproducible from package*.json; never commit.
# .vite and .next are bundler caches. Lockfiles ARE committed (one of
# package-lock.json / pnpm-lock.yaml / yarn.lock — pick one) and are NOT
# listed here.
node_modules/
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/
.vite/
*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache
coverage/
.nyc_output/
.vercel/
.netlify/


# === Python =================================================================
# Bytecode caches, virtualenvs, package metadata, common tooling caches.
# requirements.txt / poetry.lock / uv.lock ARE committed and NOT listed here.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
.env-py/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
htmlcov/
.coverage
.coverage.*


# === JVM / Android / Kotlin / Gradle ========================================
# Note: gradle-wrapper.jar IS committed (the negation rule below preserves
# it). local.properties holds developer-machine paths and is per-checkout.
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
build/
.gradle/
local.properties
*.iml
.idea/
captures/
.cxx/
*.apk
*.aab
*.ap_
*.dex


# === Static sites / Jekyll / Hugo / Eleventy / Astro ========================
# Generated output dirs vary by tool. _site is Jekyll, public is Hugo,
# .astro is Astro's cache. Add the matching one for your toolchain.
_site/
public/
.astro/
.docusaurus/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
vendor/
.bundle/
*.gem


# === Firebase / serverless / cloud SDK noise ================================
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
.serverless/
.aws-sam/
cdk.out/
.terraform/
*.tfstate
*.tfstate.*


# === IDEs / editors =========================================================
# We DO commit a tiny VSCode shared config (extensions.json + a .example
# settings) so contributors get consistent recommended extensions. The
# negation rules preserve those files.
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
!.vscode/launch.json.example
.idea/
*.swp
*.swo
*~
.history/


# === OS noise ===============================================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.Trash-*
._*


# === Misc / temporary =======================================================
*.tmp
*.bak
*.orig
*.rej
*.swp
*.lock
!package-lock.json
!pnpm-lock.yaml
!yarn.lock
!poetry.lock
!uv.lock
!Cargo.lock
